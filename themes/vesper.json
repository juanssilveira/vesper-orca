{
  "schemaVersion": 1,
  "base": "dark",
  "tokens": {
    "--background": "#101010",
    "--editor-surface": "#101010",
    "--foreground": "#FFFFFF",
    "--card": "#161616",
    "--card-foreground": "#FFFFFF",
    "--popover": "#161616",
    "--popover-foreground": "#FFFFFF",
    "--primary": "#FFC799",
    "--primary-foreground": "#000000",
    "--secondary": "#232323",
    "--secondary-foreground": "#FFFFFF",
    "--muted": "#1C1C1C",
    "--muted-foreground": "#A0A0A0",
    "--accent": "#232323",
    "--accent-foreground": "#FFFFFF",
    "--border": "#232323",
    "--input": "#282828",
    "--ring": "#707070",
    "--chart-1": "#FFC799",
    "--chart-2": "#99FFE4",
    "--chart-3": "#FF8080",
    "--chart-4": "#A0A0A0",
    "--chart-5": "#FF7300",
    "--sidebar": "#101010",
    "--sidebar-foreground": "#CCCCCC",
    "--sidebar-primary": "#FFC799",
    "--sidebar-primary-foreground": "#000000",
    "--sidebar-accent": "#232323",
    "--sidebar-accent-foreground": "#FFC799",
    "--sidebar-border": "#1C1C1C",
    "--sidebar-ring": "#505050",
    "--worktree-sidebar": "#101010",
    "--worktree-sidebar-foreground": "#CCCCCC",
    "--worktree-sidebar-accent": "#232323",
    "--worktree-sidebar-accent-foreground": "#FFC799",
    "--worktree-sidebar-border": "#1C1C1C",
    "--worktree-sidebar-ring": "#707070",
    "--worktree-sidebar-active": "#232323",
    "--worktree-sidebar-active-border": "#2A2A2A",
    "--host-badge": "#232323",
    "--host-badge-foreground": "#A0A0A0",
    "--tab-bar": "#101010",
    "--tab-active": "#161616",
    "--tab-active-foreground": "#FFFFFF",
    "--tab-active-indicator": "#FFC799",
    "--tab-inactive": "#101010",
    "--tab-inactive-foreground": "#808080",
    "--split-divider": "#232323",
    "--split-divider-hover": "#FFC799",
    "--chat-user-message": "#1C1C1C",
    "--text-link": "#FFC799",
    "--diff-added": "#99FFE4",
    "--diff-added-background": "#99FFE415",
    "--diff-added-emphasis": "#99FFE430",
    "--diff-added-gutter": "#99FFE420",
    "--diff-removed": "#FF8080",
    "--diff-removed-background": "#FF808015",
    "--diff-removed-emphasis": "#FF808030",
    "--diff-removed-gutter": "#FF808020",
    "--git-decoration-added": "#99FFE4",
    "--git-decoration-modified": "#FFC799",
    "--git-decoration-deleted": "#FF8080",
    "--git-decoration-renamed": "#FFC799",
    "--git-decoration-untracked": "#99FFE4",
    "--git-decoration-copied": "#99FFE4",
    "--git-decoration-ignored": "#666666"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment", "punctuation.definition.fenced.markdown"],
      "settings": { "foreground": "#666666" }
    },
    {
      "name": "White: variables, links, CSS properties, markdown text",
      "scope": [
        "variable",
        "constant.other.color",
        "support.other.variable",
        "string.other.link",
        "string.other.link.title.markdown",
        "variable.function.constructor",
        "entity.name.method.js",
        "support.type.property-name.css",
        "support.type.vendored.property-name.css",
        "meta.property-name.css",
        "variable.parameter.keyframe-list.css",
        "variable.parameter.url.scss",
        "meta.property-value.scss",
        "text.html.markdown",
        "punctuation.definition.list_item.markdown",
        "punctuation.definition.raw.markdown",
        "markup.raw.block.fenced.markdown",
        "variable.language.fenced.markdown",
        "punctuation.section.class.end",
        "markup.table"
      ],
      "settings": { "foreground": "#FFFFFF" }
    },
    {
      "name": "Gray: keywords, storage, operators, attributes, escapes",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator",
        "keyword.other.template",
        "keyword.other.substitution",
        "variable.language",
        "punctuation.definition.tag",
        "punctuation.separator.inheritance.php",
        "punctuation.section.embedded",
        "entity.other.attribute-name",
        "meta.property-list.scss",
        "meta.property-value.css",
        "entity.other.keyframe-offset.css",
        "meta.selector.css",
        "entity.name.tag.reference.scss",
        "entity.name.tag.nesting.css",
        "punctuation.separator.key-value.css",
        "string.regexp",
        "constant.character.escape",
        "markup.changed",
        "markup.raw.block",
        "markup.inline.raw.markdown",
        "string.other.link.description.title.markdown"
      ],
      "settings": { "foreground": "#A0A0A0" }
    },
    {
      "name": "Orange: functions, types, tags, numbers, constants, keys",
      "scope": [
        "entity.name",
        "entity.name.tag",
        "entity.name.function",
        "variable.function",
        "support.function",
        "keyword.other.special-method",
        "meta.tag.sgml",
        "constant.numeric",
        "constant.character",
        "constant.escape",
        "constant.language.boolean",
        "support.constant",
        "keyword.other",
        "keyword.other.unit",
        "support.type",
        "support.class",
        "support.type.sys-types",
        "support.other.namespace.php",
        "support.other.namespace.use.php",
        "meta.use.php",
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.class",
        "entity.other.attribute-name.id",
        "variable.parameter.misc.css",
        "support.type.property-name.json",
        "markup.heading",
        "punctuation.definition.heading.markdown",
        "constant.other.reference.link.markdown"
      ],
      "settings": { "foreground": "#FFC799" }
    },
    {
      "name": "Peppermint: strings, symbols, inserted",
      "scope": [
        "string",
        "constant.other.symbol",
        "constant.other.key",
        "meta.attribute-selector.scss",
        "markup.inserted"
      ],
      "settings": { "foreground": "#99FFE4" }
    },
    {
      "name": "Red: invalid, deleted, JS modules",
      "scope": [
        "invalid",
        "invalid.illegal",
        "markup.deleted",
        "entity.name.module.js",
        "variable.import.parameter.js",
        "variable.other.class.js"
      ],
      "settings": { "foreground": "#FF8080" }
    },
    {
      "name": "Links",
      "scope": ["markup.underline", "markup.underline.link"],
      "settings": { "foreground": "#FFC799", "fontStyle": "underline" }
    },
    {
      "name": "Italic",
      "scope": "markup.italic",
      "settings": { "foreground": "#FFFFFF", "fontStyle": "italic" }
    },
    {
      "name": "Bold",
      "scope": "markup.bold",
      "settings": { "foreground": "#FFFFFF", "fontStyle": "bold" }
    },
    {
      "name": "Markdown separator",
      "scope": "meta.separator",
      "settings": { "foreground": "#65737E", "fontStyle": "bold" }
    }
  ]
}
